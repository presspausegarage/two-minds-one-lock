# Two Minds, One Lock config -- copy to .env and fill in. Names only; never commit real values.
# Capable agent (cloud Claude). Get a key from the Anthropic console.
# Only the automated harness needs this; the drive-it-with-your-own-Claude path is key-free.
TRACER_ANTHROPIC_API_KEY=
TRACER_CAPABLE_MODEL=claude-sonnet-4-6
TRACER_CAPABLE_MAX_TOKENS=4096

# Weak agent (a local model via Ollama). Any tool-calling model works.
TRACER_OLLAMA_URL=http://localhost:11434
TRACER_OLLAMA_MODEL=gemma4:e4b

# The lock. Same seed -> identical secret for both agents ("One Lock").
TRACER_LOCK_SEED=42
TRACER_LOCK_LENGTH=3
TRACER_LOCK_ALPHABET=ABCDE
TRACER_LOCK_MAX_ATTEMPTS=8

# Harness guardrails.
TRACER_MAX_TURNS=24
TRACER_RUNS_DIR=./runs
